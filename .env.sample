# Directory where uploaded images will be stored
IMAGES_DIR=<path_to_image_dir>

# Directory where log files will be written
LOG_DIR=<path_to_log_dir>

# Number of worker processes to spawn for HTTP server
WEB_SERVER_WORKERS=<number_of_workers>

# Starting port number for worker processes (each worker gets a unique port)
WEB_SERVER_START_PORT=<start_port>

POSTGRES_DB=upload_images_db
# Port on which the PostgreSQL server is listening
POSTGRES_DB_PORT=5432

# Username for authenticating with PostgreSQL
POSTGRES_USER=admin

# Password for the PostgreSQL user
POSTGRES_PASSWORD=<some_password>

# Hostname or Docker service name of the PostgreSQL container
POSTGRES_HOST=postgres-upload-server

# ──────────────── PgBouncer Configuration ────────────────
# Username for PgBouncer authentication
PGBOUNCER_USER=bouncer_user
# Password for PgBouncer authentication
PGBOUNCER_PASSWORD=change_this_password_in_prod
# Hostname or Docker service name of the PgBouncer container
PGBOUNCER_HOST=pgbouncer-upload-server
# Port on which the PgBouncer server is listening
PGBOUNCER_PORT=6432
# Whether to use PgBouncer for database connections (true/false)
USE_PGBOUNCER=true
# Connection Pool Settings
MAX_CLIENT_CONN=200
DEFAULT_POOL_SIZE=20